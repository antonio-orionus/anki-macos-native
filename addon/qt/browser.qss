/* Browse window. Tokens (@name@) are filled by qtstyle.py per theme. */

QMainWindow { background: @ground@; }

/* Sidebar: a source list with rounded selection pills. */
QTreeView {
    background: @sidebar@;
    border: none;
    outline: 0;
    padding: 4px 6px;
    font-size: 13px;
    color: @label@;
}
QTreeView::item { padding: 3px 4px; }

/* Hover and selection are one flat band across the whole row. Qt paints the
   indent area of a row as a separate panel styled by the same ::item rule
   (no selector reaches it on its own), and the arrow column as one segment
   per indent level, so rounded corners show as boxes and seams there.
   Square pieces of one colour join without a seam. Styling ::branch at all
   stops Qt drawing native arrows, so the disclosure chevrons are drawn here. */
QTreeView { show-decoration-selected: 1; }
QTreeView::item, QTreeView::branch { border: none; border-radius: 0; border-image: none; }
QTreeView::branch { background: transparent; }
QTreeView::item:hover, QTreeView::branch:hover { background: @fill@; }
QTreeView::item:selected, QTreeView::branch:selected { background: @fill_strong@; color: @label@; }
QTreeView::branch:has-children:closed { image: url("@qtdir@/disclosure-closed-@theme@.svg"); }
QTreeView::branch:has-children:open { image: url("@qtdir@/disclosure-open-@theme@.svg"); }

/* Card/note table: no grid, quiet header, accent selection. Row colours
   for flags, marks and suspension still come from Anki. */
QTableView {
    background: @group@;
    alternate-background-color: @row_alt@;
    border: none;
    gridline-color: transparent;
    selection-background-color: @accent@;
    selection-color: @on_accent@;
    outline: 0;
    font-size: 13px;
    color: @label@;
}
QHeaderView { background: @group@; border: none; }
QHeaderView::section {
    background: @group@;
    color: @label2@;
    border: none;
    border-bottom: 1px solid @separator@;
    border-right: 1px solid @separator@;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
}

/* Search field and sidebar filter: styled app-wide by fields.qss. */

QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 3px;
}
QToolButton:hover { background: @fill@; }
QToolButton:checked, QToolButton:pressed { background: @fill_strong@; }

QSplitter::handle { background: @separator@; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* A stylesheet on a scroll area replaces native scroll bars; keep them thin
   and overlay-like. */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle { background: @fill_strong@; border-radius: 3px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:hover { background: @label3@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
